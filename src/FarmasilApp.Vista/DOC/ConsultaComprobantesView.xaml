<UserControl x:Class="FarmasilApp.Vista.DOC.ConsultaComprobantesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comun="clr-namespace:FarmasilApp.Vista.Comun"
             xmlns:primitivas="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             MinWidth="760"
             MinHeight="420">
    <Grid Background="{StaticResource PincelFondoAplicacion}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Consulta de comprobantes tributarios"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{StaticResource PincelTextoPrincipal}"
                   Margin="0,0,0,16" />

        <Border Grid.Row="1"
                Background="{StaticResource PincelMarca}"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
                    <TextBlock Text="Tipo de comprobante" Foreground="{StaticResource PincelSuperficie}" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <comun:FiltroComun Style="{StaticResource EstiloFiltroComun}" ItemsSource="{Binding TiposComprobante}"
                              SelectedItem="{Binding TipoComprobanteSeleccionado, UpdateSourceTrigger=PropertyChanged}"
                              Height="36"
                              AutomationProperties.AutomationId="DOC-CMB-FILTRO-TIPO" />
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,10,0">
                    <TextBlock Text="Número de comprobante" Foreground="{StaticResource PincelSuperficie}" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <comun:BusquedaComun Style="{StaticResource EstiloBusquedaComun}" Text="{Binding NumeroComprobante, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="20"
                             Height="36"
                             VerticalContentAlignment="Center"
                             ToolTip="Puede buscar por una parte del número"
                             AutomationProperties.AutomationId="DOC-SRH-NUMERO-COMPROBANTE" />
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,10,0">
                    <TextBlock Text="Fecha de emisión" Foreground="{StaticResource PincelSuperficie}" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding FechaEmisionTexto, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Fecha opcional: dd/MM/aaaa. Puede escribirla o elegirla en el calendario."
                                 AutomationProperties.AutomationId="DOC-FEC-FILTRO-EMISION" />
                        <!-- El texto editable se valida en Modelo; el calendario solo aporta fechas válidas. -->
                        <DatePicker Grid.Column="1"
                                    SelectedDate="{Binding FechaEmision, UpdateSourceTrigger=PropertyChanged}"
                                    Height="36"
                                    MinWidth="0"
                                    ToolTip="Elegir fecha de emisión"
                                    AutomationProperties.Name="Elegir fecha de emisión">
                            <DatePicker.Resources>
                                <Style TargetType="{x:Type primitivas:DatePickerTextBox}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>
                    </Grid>
                </StackPanel>

                <Button Grid.Column="3" Grid.Row="0"
                        Content="Consultar"
                        Command="{Binding ConsultarCommand}"
                        MinWidth="130"
                        Height="36"
                        Margin="0,24,0,0"
                        Padding="16,0"
                        Background="{StaticResource PincelMarca}"
                        Foreground="{StaticResource PincelSuperficie}"
                        FontWeight="Bold"
                        AutomationProperties.AutomationId="DOC-BTN-LEER-COMPROBANTE" />

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="Todos los filtros son opcionales. El número se busca por coincidencia parcial."
                           Foreground="{StaticResource PincelSuperficie}"
                           FontSize="12"
                           Margin="0,9,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PincelSuperficie}" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Resultados de consulta"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PincelTextoPrincipal}"
                           Margin="0,0,0,10" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Comprobantes}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="{StaticResource PincelFondoAplicacion}"
                          AutomationProperties.AutomationId="DOC-TBL-COMPROBANTES">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N° Comprobante" Binding="{Binding NumeroComprobante}" Width="2*" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoComprobante}" Width="1.1*" />
                        <DataGridTextColumn Header="Fecha de emisión" Binding="{Binding FechaEmision, StringFormat={}{0:dd/MM/yyyy}}" Width="1.3*" />
                        <DataGridTextColumn Header="Total" Binding="{Binding MontoTotal, StringFormat={}{0:C2}}" Width="1.1*" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding EstadoDocumento}" Width="1.1*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2"
                           Text="{Binding Mensaje}"
                           Foreground="{StaticResource PincelSecundario}"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
