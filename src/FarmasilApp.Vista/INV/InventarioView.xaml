<UserControl x:Class="FarmasilApp.Vista.INV.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comun="clr-namespace:FarmasilApp.Vista.Comun"
             MinWidth="800"
             MinHeight="600"
             comun:ComandoAlCargar.Command="{Binding InicializarCommand}">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Inventario"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Gestión de productos"
                       Margin="0,4,0,0"
                       FontSize="15"
                       Foreground="Gray"/>

        </StackPanel>

        <!-- Filtros -->
        <Grid Grid.Row="1"
              Margin="0,0,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="0,0,10,0">

                <TextBlock Text="Producto"/>

                <TextBox AutomationProperties.AutomationId="INV-SRH-PRODUCTO"
                         Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         Margin="0,5,0,0"
                         ToolTip="Buscar por ID o nombre"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Margin="0,0,10,0">

                <TextBlock Text="Proveedor"/>

                <ComboBox AutomationProperties.AutomationId="INV-CMB-FILTRO-PROVEEDOR"
                          ItemsSource="{Binding Proveedores}"
                          DisplayMemberPath="Nombre"
                          SelectedItem="{Binding ProveedorSeleccionado}"
                          Height="32"
                          Margin="0,5,0,0"/>

            </StackPanel>

            <StackPanel Grid.Column="2"
                        Margin="0,0,10,0">

                <TextBlock Text="Acción terapéutica"/>

                <ComboBox AutomationProperties.AutomationId="INV-CMB-FILTRO-ACCION-TERAPEUTICA"
                          ItemsSource="{Binding AccionesTerapeuticas}"
                          SelectedItem="{Binding AccionTerapeuticaSeleccionada}"
                          Height="32"
                          Margin="0,5,0,0"/>

            </StackPanel>

            <Button Grid.Column="3"
                    AutomationProperties.AutomationId="INV-BTN-LEER-PRODUCTO"
                    Content="Buscar"
                    Command="{Binding BuscarCommand}"
                    Height="32"
                    MinWidth="90"
                    Margin="0,22,0,0"
                    Padding="12,0"/>

        </Grid>

        <!-- Mensaje -->
        <TextBlock Grid.Row="2"
                   Text="{Binding Mensaje}"
                   Margin="0,0,0,10"
                   Foreground="Gray"/>

        <!-- Tarjetas -->
        <ScrollViewer Grid.Row="3"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="175"
                      Margin="0,0,0,14">

            <ItemsControl AutomationProperties.AutomationId="INV-PNL-CATALOGO"
                          ItemsSource="{Binding Productos}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border AutomationProperties.AutomationId="INV-CRD-PRODUCTO"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,10,10"
                                Width="230">

                            <StackPanel>

                                <TextBlock Text="{Binding Nombre}"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding AccionTerapeutica}"
                                           Margin="0,5,0,0"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"/>

                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Precio: S/ "/>
                                    <Run Text="{Binding PrecioVenta, StringFormat=N2}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="ID: "/>
                                    <Run Text="{Binding IdProducto}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Stock físico: "/>
                                    <Run Text="{Binding StockFisico}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Estado: "/>
                                    <Run Text="{Binding EstadoProducto}"/>
                                </TextBlock>

                                <Button AutomationProperties.AutomationId="INV-BTN-SELECCIONAR-PRODUCTO"
                                        Content="Seleccionar"
                                        Margin="0,10,0,0"
                                        Padding="10,4"
                                        Command="{Binding DataContext.SeleccionarProductoCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

        <!-- Tabla -->
        <DataGrid Grid.Row="4"
                  AutomationProperties.AutomationId="INV-TBL-PRODUCTOS"
                  ItemsSource="{Binding Productos}"
                  SelectedItem="{Binding ProductoSeleccionado}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  MinHeight="150">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding IdProducto}"
                                    Width="65"/>

                <DataGridTextColumn Header="Producto"
                                    Binding="{Binding Nombre}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Acción terapéutica"
                                    Binding="{Binding AccionTerapeutica}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Precio (S/)"
                                    Binding="{Binding PrecioVenta, StringFormat=N2}"
                                    Width="105"/>

                <DataGridTextColumn Header="Estado"
                                    Binding="{Binding EstadoProducto}"
                                    Width="120"/>

                <DataGridTextColumn Header="Stock físico"
                                    Binding="{Binding StockFisico}"
                                    Width="105"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Ficha de alta / actualización / baja -->
        <Border Grid.Row="5"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="7"
                Padding="16"
                Margin="0,14,0,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Ficha del producto"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock Margin="0,3,0,0"
                                   Foreground="Gray"
                                   FontSize="12"
                                   Text="Complete los campos para crear un producto o seleccione uno para actualizarlo."/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="ID: "
                                   Foreground="Gray"
                                   VerticalAlignment="Center"/>

                        <TextBlock AutomationProperties.AutomationId="INV-LBL-ID-PRODUCTO"
                                   Text="{Binding IdProductoFicha, TargetNullValue=Nuevo}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </Grid>

                <!-- Campos -->
                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,10,0">

                        <TextBlock Text="Nombre"/>

                        <TextBox AutomationProperties.AutomationId="INV-TXT-NOMBRE-PRODUCTO"
                                 Text="{Binding NombreProducto,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,5,0,0"
                                 MaxLength="100"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,10,0">

                        <TextBlock Text="Acción terapéutica"/>

                        <TextBox AutomationProperties.AutomationId="INV-TXT-ACCION-TERAPEUTICA"
                                 Text="{Binding AccionTerapeuticaFicha,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,5,0,0"
                                 MaxLength="150"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,10,0">

                        <TextBlock Text="Precio (S/)"/>

                        <TextBox AutomationProperties.AutomationId="INV-NUM-PRECIO-PRODUCTO"
                                 Text="{Binding PrecioVentaTexto,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,5,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Margin="0,0,10,0">

                        <TextBlock Text="Proveedor"/>

                        <ComboBox AutomationProperties.AutomationId="INV-CMB-PROVEEDOR"
                                  ItemsSource="{Binding ProveedoresActivos}"
                                  SelectedItem="{Binding ProveedorFicha}"
                                  DisplayMemberPath="RazonSocial"
                                  Height="32"
                                  Margin="0,5,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="4">

                        <TextBlock Text="Stock mínimo"/>

                        <TextBox AutomationProperties.AutomationId="INV-NUM-STOCK-MINIMO"
                                 Text="{Binding StockMinimoTexto,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>

                <!-- Acciones -->
                <Grid Grid.Row="2"
                      Margin="0,14,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="Gray"
                               FontSize="12">

                        <Run Text="Estado actual: "/>

                        <Run Text="{Binding ProductoSeleccionado.EstadoProducto,
                                           TargetNullValue=Disponible}"
                             FontWeight="SemiBold"/>

                    </TextBlock>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                        <Button AutomationProperties.AutomationId="INV-BTN-CREAR-PRODUCTO"
                                Content="Crear producto"
                                Command="{Binding CrearCommand}"
                                MinWidth="120"
                                Height="34"
                                Margin="0,0,8,0"
                                Padding="12,0"/>

                        <Button AutomationProperties.AutomationId="INV-BTN-ACTUALIZAR-PRODUCTO"
                                Content="Actualizar producto"
                                Command="{Binding ActualizarCommand}"
                                MinWidth="135"
                                Height="34"
                                Margin="0,0,8,0"
                                Padding="12,0"/>

                        <Button AutomationProperties.AutomationId="INV-BTN-CONFIRMAR-ACTUALIZACION"
                                Content="Guardar cambios"
                                Command="{Binding ConfirmarActualizacionCommand}"
                                MinWidth="125"
                                Height="34"
                                Margin="0,0,8,0"
                                Padding="12,0"/>

                        <Button AutomationProperties.AutomationId="INV-BTN-ELIMINAR-PRODUCTO"
                                Content="Dar de baja"
                                Command="{Binding EliminarCommand}"
                                MinWidth="105"
                                Height="34"
                                Padding="12,0"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>