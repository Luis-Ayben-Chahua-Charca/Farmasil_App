<UserControl x:Class="FarmasilApp.Vista.INV.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="800"
             MinHeight="500">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Inventario"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Consulta de productos"
                       Margin="0,4,0,0"
                       FontSize="15"
                       Foreground="Gray"/>

        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,0,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="0,0,10,0">

                <TextBlock Text="Producto"/>

                <TextBox AutomationProperties.AutomationId="INV-TXT-BUSQUEDA-PRODUCTO"
                         Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         Margin="0,5,0,0"
                         ToolTip="Buscar por ID o nombre"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Margin="0,0,10,0">

                <TextBlock Text="Proveedor"/>

                <ComboBox AutomationProperties.AutomationId="INV-CMB-FILTRO-PROVEEDOR"
                          ItemsSource="{Binding Proveedores}"
                          SelectedItem="{Binding ProveedorSeleccionado}"
                          Height="32"
                          Margin="0,5,0,0"/>

            </StackPanel>

            <StackPanel Grid.Column="2"
                        Margin="0,0,10,0">

                <TextBlock Text="Acción terapéutica"/>

                <ComboBox AutomationProperties.AutomationId="INV-CMB-FILTRO-ACCION-TERAPEUTICA"
                          ItemsSource="{Binding AccionesTerapeuticas}"
                          SelectedItem="{Binding AccionTerapeuticaSeleccionada}"
                          Height="32"
                          Margin="0,5,0,0"/>

            </StackPanel>

            <Button Grid.Column="3"
                    AutomationProperties.AutomationId="INV-BTN-LEER-PRODUCTO"
                    Content="Buscar"
                    Command="{Binding BuscarCommand}"
                    Height="32"
                    MinWidth="90"
                    Margin="0,22,0,0"
                    Padding="12,0"/>

        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding Mensaje}"
                   Margin="0,0,0,10"
                   Foreground="Gray"/>

        <DataGrid Grid.Row="3"
                  AutomationProperties.AutomationId="INV-TBL-PRODUCTOS"
                  ItemsSource="{Binding Productos}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding IdProducto}"
                                    Width="70"/>

                <DataGridTextColumn Header="Producto"
                                    Binding="{Binding Nombre}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Acción terapéutica"
                                    Binding="{Binding AccionTerapeutica}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Precio (S/)"
                                    Binding="{Binding PrecioVenta, StringFormat=N2}"
                                    Width="110"/>

                <DataGridTextColumn Header="Estado"
                                    Binding="{Binding EstadoProducto}"
                                    Width="120"/>

                <DataGridTextColumn Header="Stock físico"
                                    Binding="{Binding StockFisico}"
                                    Width="110"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>
