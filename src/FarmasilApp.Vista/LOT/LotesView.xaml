<UserControl x:Class="FarmasilApp.Vista.LOT.LotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comun="clr-namespace:FarmasilApp.Vista.Comun"
             MinWidth="800"
             MinHeight="500"
             comun:ComandoAlCargar.Command="{Binding InicializarCommand}">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Lotes"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Gestión de remesas y existencias por lote"
                       Margin="0,4,0,0"
                       FontSize="15"
                       Foreground="Gray"/>

        </StackPanel>

        <!-- Filtros ESP-0042 -->
        <Grid Grid.Row="1"
              Margin="0,0,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="0,0,10,0">

                <TextBlock Text="Medicamento"/>

                <ComboBox AutomationProperties.AutomationId="LOT-CMB-FILTRO-PRODUCTO"
                          ItemsSource="{Binding Medicamentos}"
                          SelectedItem="{Binding MedicamentoFiltro}"
                          DisplayMemberPath="Nombre"
                          Height="32"
                          Margin="0,5,0,0"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Margin="0,0,10,0">

                <TextBlock Text="Número de lote"/>

                <TextBox AutomationProperties.AutomationId="LOT-SRH-NUMERO-LOTE"
                         Text="{Binding NumeroLoteFiltro,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         Margin="0,5,0,0"/>

            </StackPanel>

            <StackPanel Grid.Column="2"
                        Margin="0,0,10,0">

                <TextBlock Text="Estado"/>

                <ComboBox AutomationProperties.AutomationId="LOT-CMB-FILTRO-ESTADO-LOTE"
                          ItemsSource="{Binding EstadosFiltro}"
                          SelectedItem="{Binding EstadoFiltro}"
                          Height="32"
                          Margin="0,5,0,0"/>

            </StackPanel>

            <Button Grid.Column="3"
                    AutomationProperties.AutomationId="LOT-BTN-LEER-LOTE"
                    Content="Buscar"
                    Command="{Binding BuscarCommand}"
                    Height="32"
                    MinWidth="90"
                    Margin="0,22,0,0"
                    Padding="12,0"/>

        </Grid>

        <!-- Resumen -->
        <TextBlock Grid.Row="2"
                   Text="{Binding Mensaje}"
                   Margin="0,0,0,10"
                   Foreground="Gray"/>

        <!-- Tarjetas de remesas -->
        <ScrollViewer Grid.Row="3"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="190"
                      Margin="0,0,0,14">

            <ItemsControl AutomationProperties.AutomationId="LOT-PNL-REMESAS"
                          ItemsSource="{Binding Remesas}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border AutomationProperties.AutomationId="LOT-CRD-REMESA"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,10,10"
                                Width="250">

                            <StackPanel>

                                <TextBlock Text="{Binding NombreMedicamento}"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           TextWrapping="Wrap"/>

                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Lote: "/>
                                    <Run Text="{Binding NumeroLote}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Vence: "/>
                                    <Run Text="{Binding FechaVencimiento,
                                                       StringFormat={}{0:dd/MM/yyyy}}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Stock: "/>
                                    <Run Text="{Binding StockActual}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Estado: "/>
                                    <Run Text="{Binding Estado}"/>
                                </TextBlock>

                                <Button AutomationProperties.AutomationId="LOT-BTN-SELECCIONAR-REMESA"
                                        Content="Seleccionar"
                                        Margin="0,10,0,0"
                                        Padding="10,4"
                                        Command="{Binding DataContext.SeleccionarRemesaCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

        <!-- Tabla ESP-0042 -->
        <DataGrid Grid.Row="4"
                  AutomationProperties.AutomationId="LOT-TBL-LOTES"
                  ItemsSource="{Binding Remesas}"
                  SelectedItem="{Binding RemesaSeleccionada}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding IdLote}"
                                    Width="65"/>

                <DataGridTextColumn Header="Medicamento"
                                    Binding="{Binding NombreMedicamento}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Lote"
                                    Binding="{Binding NumeroLote}"
                                    Width="130"/>

                <DataGridTextColumn Header="Vencimiento"
                                    Binding="{Binding FechaVencimiento,
                                                      StringFormat={}{0:dd/MM/yyyy}}"
                                    Width="115"/>

                <DataGridTextColumn Header="Stock"
                                    Binding="{Binding StockActual}"
                                    Width="80"/>

                <DataGridTextColumn Header="Estado"
                                    Binding="{Binding Estado}"
                                    Width="150"/>

                <DataGridTextColumn Header="Proveedor"
                                    Binding="{Binding IdProveedor}"
                                    Width="95"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Ficha ESP-0041 / ESP-0043 / ESP-0044 -->
        <Border Grid.Row="5"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,14,0,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado ficha -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Ficha de la remesa"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock Margin="0,3,0,0"
                                   Foreground="Gray"
                                   FontSize="12"
                                   Text="Complete los datos para registrar una remesa o seleccione una existente para actualizarla."/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="ID: "
                                   Foreground="Gray"/>

                        <TextBlock Text="{Binding IdLoteFicha,
                                                 TargetNullValue=Nuevo}"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                </Grid>

                <!-- Primera fila -->
                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,10,0">

                        <TextBlock Text="Medicamento"/>

                        <ComboBox AutomationProperties.AutomationId="LOT-CMB-PRODUCTO"
                                  ItemsSource="{Binding Medicamentos}"
                                  SelectedItem="{Binding MedicamentoFicha}"
                                  DisplayMemberPath="Nombre"
                                  Height="32"
                                  Margin="0,5,0,0">

                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="IsEnabled"
                                            Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EnEdicion}"
                                                     Value="True">
                                            <Setter Property="IsEnabled"
                                                    Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>

                        </ComboBox>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,10,0">

                        <TextBlock Text="Proveedor"/>

                        <ComboBox AutomationProperties.AutomationId="LOT-CMB-PROVEEDOR-LOTE"
                                  ItemsSource="{Binding Proveedores}"
                                  SelectedItem="{Binding ProveedorFicha}"
                                  DisplayMemberPath="RazonSocial"
                                  Height="32"
                                  Margin="0,5,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Número de lote"/>

                        <TextBox AutomationProperties.AutomationId="LOT-TXT-NUMERO-LOTE"
                                 Text="{Binding NumeroLote,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>

                <!-- Segunda fila -->
                <Grid Grid.Row="2"
                      Margin="0,12,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,10,0">

                        <TextBlock Text="Fecha de vencimiento"/>

                        <DatePicker AutomationProperties.AutomationId="LOT-FEC-FECHA-VENCIMIENTO"
                                    SelectedDate="{Binding FechaVencimiento}"
                                    Height="32"
                                    Margin="0,5,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,10,0">

                        <TextBlock Text="Stock"/>

                        <TextBox AutomationProperties.AutomationId="LOT-NUM-STOCK-LOTE"
                                 Text="{Binding Stock,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,5,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,10,0">

                        <TextBlock Text="Fecha de ingreso"/>

                        <DatePicker AutomationProperties.AutomationId="LOT-FEC-FECHA-INGRESO"
                                    SelectedDate="{Binding FechaIngreso}"
                                    Height="32"
                                    Margin="0,5,0,0">

                            <DatePicker.Style>
                                <Style TargetType="DatePicker">
                                    <Setter Property="IsEnabled"
                                            Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EnEdicion}"
                                                     Value="True">
                                            <Setter Property="IsEnabled"
                                                    Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DatePicker.Style>

                        </DatePicker>

                    </StackPanel>

                    <StackPanel Grid.Column="3">

                        <TextBlock Text="Estado"/>

                        <TextBox AutomationProperties.AutomationId="LOT-TXT-ESTADO-LOTE"
                                 Text="{Binding EstadoFicha,
                                                Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="32"
                                 Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>

                <!-- Acciones -->
                <Grid Grid.Row="3"
                      Margin="0,14,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="Gray"
                               FontSize="12">

                        <Run Text="Estado actual: "/>

                        <Run Text="{Binding EstadoFicha,
                                           Mode=OneWay}"
                             FontWeight="SemiBold"/>

                    </TextBlock>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                        <Button AutomationProperties.AutomationId="LOT-BTN-NUEVA-REMESA"
                                Content="Nueva remesa"
                                Command="{Binding NuevaCommand}"
                                MinWidth="110"
                                Height="34"
                                Margin="0,0,8,0"
                                Padding="12,0"/>

                        <Button AutomationProperties.AutomationId="LOT-BTN-CREAR-LOTE"
                                Content="Crear remesa"
                                Command="{Binding CrearCommand}"
                                MinWidth="110"
                                Height="34"
                                Margin="0,0,8,0"
                                Padding="12,0"/>

                        <Button AutomationProperties.AutomationId="LOT-BTN-ACTUALIZAR-LOTE"
                                Content="Actualizar"
                                Command="{Binding ActualizarCommand}"
                                MinWidth="100"
                                Height="34"
                                Margin="0,0,8,0"
                                Padding="12,0"/>

                        <Button AutomationProperties.AutomationId="LOT-BTN-CONFIRMAR-ACTUALIZACION"
                                Content="Guardar cambios"
                                Command="{Binding ConfirmarActualizacionCommand}"
                                MinWidth="125"
                                Height="34"
                                Margin="0,0,8,0"
                                Padding="12,0"/>

                        <Button AutomationProperties.AutomationId="LOT-BTN-ELIMINAR-LOTE"
                                Content="Dar de baja"
                                Command="{Binding EliminarCommand}"
                                MinWidth="105"
                                Height="34"
                                Padding="12,0"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>
</UserControl>