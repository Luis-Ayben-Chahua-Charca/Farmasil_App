<Window x:Class="FarmasilApp.Vista.Principal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}" Height="720" Width="1180"
        MinHeight="600" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainWindowStyle}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource NavigationSidebarStyle}">
            <StackPanel>
                <TextBlock Text="FARMASIL"
                           Style="{StaticResource NavigationTitleStyle}" />
                <TextBlock Text="Módulos"
                           Style="{StaticResource NavigationSectionStyle}" />
                <ItemsControl ItemsSource="{Binding Modulos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Nombre}"
                                    Command="{Binding AbrirCommand}"
                                    Style="{StaticResource NavigationButtonStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Margin="16"
                Style="{StaticResource MainContentStyle}">
            <ContentControl Content="{Binding Navegacion.Actual}" />
        </Border>
    </Grid>
</Window>
