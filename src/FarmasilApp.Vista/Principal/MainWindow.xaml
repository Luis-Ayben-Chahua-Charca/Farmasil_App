<Window x:Class="FarmasilApp.Vista.Principal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}" Height="720" Width="1180"
        MinHeight="600" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource EstiloVentanaPrincipal}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanAVisibilidad" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sin sesión no hay menú: solo se ve el inicio de sesión (VP-00). -->
        <Border Grid.Column="0"
                Width="220"
                Visibility="{Binding HaySesion, Converter={StaticResource BooleanAVisibilidad}}"
                Style="{StaticResource EstiloBarraMenu}">
            <StackPanel>
                <TextBlock Text="FARMASIL"
                           Style="{StaticResource EstiloTituloMenu}" />
                <TextBlock Text="Módulos"
                           Style="{StaticResource EstiloSeccionMenu}" />
                <!-- Los botones del menú todavía no tienen identificador en la guía de nomenclatura (PEN-037):
                     no se inventa uno (DEC-060). El botón queda deshabilitado cuando el rol no puede abrir el
                     módulo, porque su comando no se puede ejecutar, y el tooltip muestra el motivo (DEC-075). -->
                <ItemsControl ItemsSource="{Binding Modulos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Nombre}"
                                    Command="{Binding AbrirCommand}"
                                    ToolTip="{Binding Motivo}"
                                    Style="{StaticResource EstiloBotonMenu}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding UsuarioSesion}"
                           Style="{StaticResource EstiloSeccionMenu}"
                           Margin="8,24,8,8" />
                <Button AutomationProperties.AutomationId="USR-BTN-CERRAR-SESION"
                        Content="Cerrar sesión"
                        Command="{Binding CerrarSesionCommand}"
                        Style="{StaticResource EstiloBotonMenu}" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- RNF-0010.1: el evento de fondo actualiza este aviso desde el hilo de WPF. -->
            <Border Grid.Row="0" Padding="12" Margin="0,0,0,10"
                    CornerRadius="6" Background="#FFF4DE" BorderBrush="#D5A14E"
                    BorderThickness="1"
                    Visibility="{Binding HayAvisoVencimientos, Converter={StaticResource BooleanAVisibilidad}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Ver alertas"
                            Margin="12,0,0,0" Padding="12,5"
                            Command="{Binding AbrirAvisoVencimientosCommand}" />
                    <TextBlock Text="{Binding TextoAvisoVencimientos}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="#493500" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource EstiloContenidoPrincipal}">
                <ContentControl Content="{Binding Navegacion.Actual}" />
            </Border>
        </Grid>
    </Grid>
</Window>
