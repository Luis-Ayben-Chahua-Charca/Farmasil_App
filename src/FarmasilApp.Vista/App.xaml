<Application x:Class="FarmasilApp.Vista.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Primero los colores y estilos, después los controles comunes que los usan y al final
                     las plantillas de las pantallas. -->
                <ResourceDictionary Source="Comun/Estilos.xaml" />
                <ResourceDictionary Source="Comun/ControlesComunes.xaml" />
                <ResourceDictionary Source="Comun/Plantillas.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
