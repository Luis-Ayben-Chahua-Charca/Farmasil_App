<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:comun="clr-namespace:FarmasilApp.Vista.Comun">
    <Style x:Key="CommonListStyle" TargetType="{x:Type comun:ListaComun}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CommonSearchStyle" TargetType="{x:Type comun:BusquedaComun}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CommonFilterStyle" TargetType="{x:Type comun:FiltroComun}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ConfirmationCancelButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Background" Value="#64748B"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="ConfirmationAcceptButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Background" Value="#DC2626"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="ConfirmUpdateButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Content" Value="Guardar cambios"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>
</ResourceDictionary>
