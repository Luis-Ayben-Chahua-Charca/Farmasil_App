<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:comun="clr-namespace:FarmasilApp.Vista.Comun">
    <!-- App.xaml carga este diccionario después de Estilos.xaml. Los colores compartidos se toman de allí con
         DynamicResource, porque un StaticResource no ve las claves de otro diccionario hermano. -->
    <Style x:Key="EstiloListaComun" TargetType="{x:Type comun:ListaComun}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EstiloBusquedaComun" TargetType="{x:Type comun:BusquedaComun}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="EstiloFiltroComun" TargetType="{x:Type comun:FiltroComun}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="EstiloBotonConfirmarNo" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Background" Value="{DynamicResource PincelSecundario}"/>
        <Setter Property="Foreground" Value="{DynamicResource PincelSuperficie}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="EstiloBotonConfirmarSi" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Background" Value="{DynamicResource PincelPeligro}"/>
        <Setter Property="Foreground" Value="{DynamicResource PincelSuperficie}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="EstiloBotonConfirmarActualizacion" TargetType="{x:Type Button}">
        <Setter Property="Content" Value="Guardar cambios"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>
</ResourceDictionary>
