<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:FarmasilApp.VistaModelo.Principal;assembly=FarmasilApp.VistaModelo"
                    xmlns:vmAlv="clr-namespace:FarmasilApp.VistaModelo.ALV;assembly=FarmasilApp.VistaModelo"
                    xmlns:vistaAlv="clr-namespace:FarmasilApp.Vista.ALV"
                    xmlns:vmInv="clr-namespace:FarmasilApp.VistaModelo.INV;assembly=FarmasilApp.VistaModelo"
                    xmlns:vmDoc="clr-namespace:FarmasilApp.VistaModelo.DOC;assembly=FarmasilApp.VistaModelo"
                    xmlns:vistaDoc="clr-namespace:FarmasilApp.Vista.DOC"
                    xmlns:vmPag="clr-namespace:FarmasilApp.VistaModelo.PAG;assembly=FarmasilApp.VistaModelo"
                    xmlns:vista="clr-namespace:FarmasilApp.Vista.Principal"
                    xmlns:vistaInv="clr-namespace:FarmasilApp.Vista.INV"
                    xmlns:vistaPag="clr-namespace:FarmasilApp.Vista.PAG"
                    xmlns:vmPrv="clr-namespace:FarmasilApp.VistaModelo.PRV;assembly=FarmasilApp.VistaModelo"
                    xmlns:vistaPrv="clr-namespace:FarmasilApp.Vista.PRV"
                    xmlns:vmUsr="clr-namespace:FarmasilApp.VistaModelo.USR;assembly=FarmasilApp.VistaModelo"
                    xmlns:vistaUsr="clr-namespace:FarmasilApp.Vista.USR">
    <!-- Cada VistaModelo se asocia con su pantalla aquí. La navegación solo cambia la VistaModelo activa. -->
    <DataTemplate DataType="{x:Type vm:InicioViewModel}">
        <vista:InicioView />
    </DataTemplate>

    <!-- Consulta de alertas de vencimiento (ESP-0013, Issue #87). -->
    <DataTemplate DataType="{x:Type vmAlv:AlertasViewModel}">
        <vistaAlv:AlertasView />
    </DataTemplate>

    <!-- Consulta de comprobantes tributarios (ESP-0010). -->
    <DataTemplate DataType="{x:Type vmDoc:ComprobantesViewModel}">
        <vistaDoc:ConsultaComprobantesView />
    </DataTemplate>

    <!-- Consulta de Inventario (ESP-0006). -->
    <DataTemplate DataType="{x:Type vmInv:InventarioViewModel}">
        <vistaInv:InventarioView />
    </DataTemplate>

    <!-- Consulta de métodos de pago (ESP-0018). -->
    <DataTemplate DataType="{x:Type vmPag:MetodosPagoViewModel}">
        <vistaPag:MetodosPagoView />
    </DataTemplate>

    <!-- Consulta de Proveedores (ESP-0038). -->
    <DataTemplate DataType="{x:Type vmPrv:ProveedoresViewModel}">
        <vistaPrv:ProveedoresView />
    </DataTemplate>

    <!-- Inicio de sesión: pantalla mínima sin mockup (RNF-0006, condición 1; DEC-080). -->
    <DataTemplate DataType="{x:Type vmUsr:InicioSesionViewModel}">
        <vistaUsr:InicioSesionView />
    </DataTemplate>

    <!-- Usuarios, pantalla única de las cuatro operaciones (ESP-0033 a ESP-0036). -->
    <DataTemplate DataType="{x:Type vmUsr:UsuariosViewModel}">
        <vistaUsr:UsuariosView />
    </DataTemplate>
</ResourceDictionary>
