@startuml
left to right direction
skinparam packageStyle rectangle

actor "Técnica farmacéutica\n<<Tecnico>>" as Tecnica
actor "Dueña de la farmacia\n<<Administrador>>" as Duena

rectangle "Gestión de Inventario (EDU-0002)" {
    usecase "Registrar producto\n(ILA-0005)" as UC_Registrar
    usecase "Consultar inventario\n(ILA-0006)" as UC_Consultar
    usecase "Actualizar producto\n(ILA-0007)" as UC_Actualizar
    usecase "Dar de baja producto\n(ILA-0008)" as UC_Baja

    note "Las remesas, su vencimiento y sus existencias\nse gestionan en el módulo de Lotes (EDU-0015).\nLas alertas de vencimiento, en el módulo 4 (EDU-0004)." as N1
}

' La Técnica solo consulta (Matriz de Permisos)
Tecnica --> UC_Consultar

' La Dueña administra el catálogo de medicamentos
Duena --> UC_Registrar
Duena --> UC_Consultar
Duena --> UC_Actualizar
Duena --> UC_Baja

UC_Actualizar ..> UC_Consultar : <<include>>
UC_Baja ..> UC_Consultar : <<include>>

@enduml